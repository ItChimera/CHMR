{
  "name": "chmr-desktop",
  "version": "1.1.0",
  "description": "CHMR — Downloadable Native Desktop Video Editor",
  "author": "CHMR",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node prepare-web.mjs",
    "start": "node prepare-web.mjs && electron .",
    "start:raw": "electron .",
    "server:only": "node prepare-web.mjs && node local-server.cjs",
    "dist": "node prepare-web.mjs && electron-builder",
    "dist:win": "node prepare-web.mjs && electron-builder --win",
    "dist:mac": "node prepare-web.mjs && electron-builder --mac",
    "dist:linux": "node prepare-web.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.chmr.videoeditor",
    "productName": "CHMR",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "local-server.cjs",
      "web/**/*",
      "icon.ico",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CHMR-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "CHMR-Portable-${version}.exe"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "CHMR-${version}-${arch}.dmg"
    },
    "linux": {
      "icon": "icon.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "artifactName": "CHMR-${version}.AppImage"
    }
  }
}
